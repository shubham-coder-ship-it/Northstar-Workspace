# Documentation only: the application does not automatically load .env files.
# Inject real values securely into the server process. Never commit .env.
APP_SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEY=
APP_DATABASE=/workspace/trading-bot-assignment/instance/app.sqlite3
PUBLIC_URL=https://your-domain.example
# Optional support subscriptions: use Stripe test mode first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
BILLING_LIVE_ENABLED=false

# Optional account email. Use an SMTP server with implicit TLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
